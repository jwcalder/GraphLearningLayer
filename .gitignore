# -----------------------------
# Project data folders
# -----------------------------
# Save folder (keep folder, ignore all contents)
save/**
!save/.gitkeep
!save/README.md

# Datasets folder (keep folder, ignore all contents)
# This prevents large archives like CIFAR-10 from being committed.
datasets/**
!datasets/.gitkeep
!datasets/README.md
